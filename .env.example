# ==============================================================================
# MESH-TACTIC TACTICAL SDR & RAILWAY AIS CONFIGURATION
# Copy this file to .env and adjust values for each node.
# ==============================================================================

# --- Node Identity & Role ---
NODE_ID=0x0001
NODE_ALIAS=mac
CALLSIGN=COMMANDER-MAC
TARGET_ID=0xFFFF

# --- Radio Hardware (ADALM-PLUTO / PLUTO+) ---
# SDR_URI options:
#   auto              : Auto-detects based on host machine
#   ip:192.168.2.10   : Standard Pluto USB Ethernet IP (Mac / PC)
#   usb:1.3.5         : Direct Linux USB IIO context (Raspberry Pi 5)
#   ip:192.168.99.240 : Outpost / Armbian static IP (AML / Pi Zero 2W)
SDR_URI=auto

CARRIER_FREQ=915000000
SAMPLE_RATE=2500000
RX_GAIN=65.0
TX_ATTEN=0.0

# --- Network & Multi-Hop Relay ---
ENABLE_RELAY=true
DEFAULT_TTL=3

# --- MAC Layer & Anti-Collision (LBT / S-TDMA) ---
# Options:
#   lbt     : Listen-Before-Talk CSMA/CA with random backoff (Recommended)
#   slotted : Slotted-LBT aligning bursts to 50ms time slot boundaries
#   stdma   : Self-Organizing TDMA reservation map (GPS PPS compatible)
#   off     : Raw ALOHA uncoordinated transmission
MAC_MODE=lbt
MAC_SLOTS_PER_FRAME=20
MAC_FRAME_DURATION=1.0
MAC_MIN_BACKOFF_MS=25.0
MAC_MAX_BACKOFF_MS=90.0

# --- GNU Radio / Socket PDU (Optional) ---
USE_SOCKET=false
SOCKET_HOST=127.0.0.1
SOCKET_TX_PORT=52001
SOCKET_RX_PORT=52002

# --- Railway AIS / Gateway Station (Optional) ---
IS_GATEWAY=false
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883

# --- Simulation Mode (Dummy GPS + Device Condition in Hex) ---
SIM_ENABLED=false                # Automatically broadcast dummy GPS & status on startup
SIM_INTERVAL=5.0                 # Interval in seconds between simulated telemetry broadcasts

